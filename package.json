{
  "name": "french-writing-prompter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/migrate.ts",
    "build": "next build",
    "start": "next start",
    "prestart": "tsx scripts/migrate.ts",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "TZ=America/Chicago vitest run",
    "test:watch": "TZ=America/Chicago vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint:ast": "ast-grep scan && ast-grep test --skip-snapshot-tests",
    "check": "npm run typecheck && npm run lint && npm run lint:ast && npm run knip && npm run format:check && npm run test",
    "ci": "npm run check && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "pr:size": "tsx scripts/pr-size.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.17.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "openai": "^6.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/eslint-plugin": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "knip": "^5.70.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.7"
  }
}
